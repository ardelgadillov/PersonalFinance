# Copy this file to .env and fill in your values. .env is gitignored: never commit it.

# REQUIRED for real data: your SimpleFIN Bridge access URL (it contains your credentials).
# Format: https://<username>:<password>@<bridge-host>/simplefin
SIMPLEFIN_ACCESS_URL=https://USERNAME:PASSWORD@beta-bridge.simplefin.org/simplefin

# OPTIONAL: time zone used to turn bank timestamps into dates (default America/New_York).
# Examples: America/Chicago, America/Denver, America/Los_Angeles, Europe/Madrid
# FINANCE_TIMEZONE=America/New_York

# OPTIONAL: where the database and raw downloads are stored (default: ./data).
# FINANCE_DATA_DIR=C:/Users/you/Documents/finance-data

# OPTIONAL: 1 = always use the fake demo data in <data dir>/demo (no SimpleFIN calls).
# Usually easier to use the --demo flag instead: python -m finance --demo status
# FINANCE_DEMO=0
